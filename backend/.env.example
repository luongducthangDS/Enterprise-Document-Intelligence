# ============================================
# HR AI Backend Service — Environment Variables
# ============================================

# ---- App Configuration ----
APP_NAME="HR AI Backend Service"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=hr_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/hr_ai_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_POOL_PRE_PING=false
DATABASE_ECHO=false
DATABASE_USE_TRANSACTION_POOLER=true

# ---- JWT Authentication ----
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- External AI Agent REST Service ----
# Local development URL. Docker Compose overrides this with the internal agent service URL.
AI_AGENT_SERVICE_URL=http://localhost:8001/api/v1/agent
AI_AGENT_TIMEOUT_SECONDS=60.0
AI_AGENT_SERVICE_TOKEN=change-me
