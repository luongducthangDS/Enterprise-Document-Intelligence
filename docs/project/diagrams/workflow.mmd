%%{init: {
  "flowchart": { "defaultRenderer": "elk" },
  "theme": "dark",
  "themeVariables": {
    "primaryColor": "#1e1e2e",
    "primaryTextColor": "#cdd6f4",
    "primaryBorderColor": "#45475a",
    "lineColor": "#89b4fa",
    "secondaryColor": "#181825",
    "tertiaryColor": "#11111b",
    "background": "#1e1e2e",
    "mainBkg": "#1e1e2e",
    "nodeBorder": "#45475a",
    "clusterBkg": "#181825",
    "clusterBorder": "#585b70",
    "titleColor": "#cdd6f4",
    "edgeLabelBackground": "#313244",
    "fontFamily": "Inter, Segoe UI, sans-serif"
  }
}}%%

flowchart TD

  %% ─────────────────────────────────────────────
  %% ENTRY
  %% ─────────────────────────────────────────────
  USER(["User\nEmployee / HR Admin"])

  %% ─────────────────────────────────────────────
  %% SCREEN 1 — Login & Auth
  %% ─────────────────────────────────────────────
  subgraph S1 ["SCREEN 1 — Login & Auth"]
    direction TB
    S1_ROLE["Role Selection\n─────────────────────────────\nEmployee  /  HR Admin"]
    S1_2FA["2FA Verification\n─────────────────────────────\nOne-time code check"]
    S1_ROLE --> S1_2FA
  end

  %% ─────────────────────────────────────────────
  %% SCREEN 2 — AI Assistant Chat
  %% ─────────────────────────────────────────────
  subgraph S2 ["SCREEN 2 — AI Assistant Chat"]
    direction TB
    S2_QUERY["User Query\n─────────────────────────────\n\"What's the hybrid work policy?\""]
    S2_THINK["Routing & Retrieval\n─────────────────────────────\nThinking indicator"]
    S2_CONF["Confidence Score\n─────────────────────────────\nHigh / Low indicator"]
    S2_ANSWER["Answer Card\n─────────────────────────────\nResponse + clickable citations"]
    S2_QUERY --> S2_THINK --> S2_CONF --> S2_ANSWER
  end

  %% ─────────────────────────────────────────────
  %% SCREEN 3 — Ticket Escalation Pop-up
  %% ─────────────────────────────────────────────
  subgraph S3 [" SCREEN 3 — Ticket Escalation Pop-up"]
    direction TB
    S3_WARN["Low Confidence Warning\n─────────────────────────────\nAnswer flagged uncertain"]
    S3_MODAL["HR Ticket Created\n─────────────────────────────\nAuto-generated pop-up modal"]
    S3_WARN --> S3_MODAL
  end

  %% ─────────────────────────────────────────────
  %% SCREEN 4 — HR Admin Dashboard
  %% ─────────────────────────────────────────────
  subgraph S4 ["SCREEN 4 — HR Admin Dashboard"]
    direction TB
    S4_TICKETS["Ticket Management Table\n─────────────────────────────\nStatus, assignee, SLA"]
    S4_DOCS["Document Management\n─────────────────────────────\nUpload + vector indexing status"]
  end

  %% ═════════════════════════════════════════════
  %% WORKFLOW EDGES (agent flow labels)
  %% ═════════════════════════════════════════
  USER -->|"Login"| S1_ROLE
  S1_2FA -->|"Check Auth"| S2_QUERY
  S2_THINK -->|"Intent Router & RAG Retrieval"| S2_CONF

  S2_CONF -->|"Hallucination Check Pass\n(High confidence)"| S2_ANSWER
  S2_ANSWER --> END_OK(["Final Answer Shown"])
  S2_CONF -->|"Hallucination Check Fail\n(Low confidence)"| S3_WARN
  S3_MODAL -->|"Auto Escalation"| S4_TICKETS

  S4_TICKETS -->|"HR resolves & notifies user"| S2_ANSWER
  S4_DOCS -->|"Re-index"| S2_THINK

  %% ─────────────────────────────────────────────
  %% STYLING
  %% ─────────────────────────────────────────────
  classDef entryNode   fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#e0f2fe
  classDef authNode    fill:#1c2b3a,stroke:#89b4fa,stroke-width:1.5px,color:#cce7ff
  classDef chatNode    fill:#1e1e2e,stroke:#89b4fa,stroke-width:1.5px,color:#cdd6f4
  classDef escNode     fill:#4a1a1a,stroke:#e74c3c,stroke-width:2px,color:#ffcccc
  classDef dashNode    fill:#3b1f5e,stroke:#a855f7,stroke-width:1.5px,color:#f3e8ff
  classDef endOk       fill:#1a472a,stroke:#2ecc71,stroke-width:2px,color:#ffffff

  class USER entryNode
  class S1_ROLE,S1_2FA authNode
  class S2_QUERY,S2_THINK,S2_ANSWER,S2_CONF chatNode
  class S3_WARN,S3_MODAL escNode
  class S4_TICKETS,S4_DOCS dashNode
  class END_OK endOk
