%% End-to-end product workflow after Agent-BE-FE mapping.
flowchart TD
    subgraph LEGEND["Legend"]
        CURRENT["Implemented"]
        FUTURE["Future"]
    end

    START["User opens Next.js application"]
    LOGIN["Login with email and password"]
    AUTH{"JWT valid?"}
    ROLE["BE returns profile, role and department"]
    HOME{"Selected function"}

    subgraph CHAT["Current chat workflow"]
        CONV["Create active conversation"]
        QUESTION["Submit question"]
        REQUEST["BE persists user Message and ChatRequest=QUEUED"]
        TASK["Background task calls Agent service"]
        AGENT["LangGraph routes, retrieves, reranks,\ngenerates and evaluates confidence"]
        MAP["BE maps AgentAnswer and persists result"]
        POLL["FE polls ChatRequest"]
        CHAT_STATE{"Terminal state"}
        ANSWER["COMPLETED\nRender answer, warnings and citations"]
        SOURCE["Open citation detail\nOwnership and confidentiality checked"]
        CLARIFY["CLARIFICATION_REQUIRED\nRender clarifying question"]
        FOLLOWUP["Submit clarification in same conversation"]
        CONTEXT["BE combines original question,\nclarifying question and new answer"]
        REFUSED["REFUSED\nRender insufficient-evidence/escalation note"]
        TICKET["Create TicketDB when escalate=true"]
        FAILED["FAILED\nRender safe error and retry action"]
        RETRY["Create child ChatRequest\nKeep parent_chat_request_id"]
    end

    subgraph ADMIN["Current HR Admin workflow"]
        ADMIN_RBAC{"HR_ADMIN or SUPER_ADMIN?"}
        DOCS["Upload/list/detail/archive documents"]
        DOC_JOB["Create IngestionJob=QUEUED"]
        INDEX["Create and poll index rebuild job"]
        EVAL["Create and poll evaluation run"]
    end

    subgraph FUTURE_FLOW["Future workflow"]
        TWO_FA["2FA / SSO"]
        INGEST["Persist source file, extract, clean,\nchunk, embed and upsert ChromaDB"]
        DURABLE["Durable queue, timeout recovery and idempotency"]
        TICKET_UI["Ticket list, assignment, resolution,\nnotification and ticket status in FE"]
        MONITOR["Monitoring and user feedback"]
        RETRIEVAL_RBAC["Filter Agent retrieval by access scope"]
    end

    START --> LOGIN --> AUTH
    AUTH -->|"No"| LOGIN
    AUTH -->|"Yes"| ROLE --> HOME
    HOME -->|"Chat"| CONV --> QUESTION --> REQUEST
    REQUEST --> TASK --> AGENT --> MAP
    REQUEST --> POLL
    MAP --> POLL --> CHAT_STATE
    CHAT_STATE -->|"COMPLETED"| ANSWER --> SOURCE
    CHAT_STATE -->|"CLARIFICATION_REQUIRED"| CLARIFY --> FOLLOWUP --> CONTEXT --> REQUEST
    CHAT_STATE -->|"REFUSED"| REFUSED
    MAP -->|"escalate=true"| TICKET --> REFUSED
    CHAT_STATE -->|"FAILED"| FAILED --> RETRY --> TASK

    HOME -->|"Admin"| ADMIN_RBAC
    ADMIN_RBAC -->|"Denied"| HOME
    ADMIN_RBAC -->|"Allowed"| DOCS --> DOC_JOB
    ADMIN_RBAC -->|"Allowed"| INDEX
    ADMIN_RBAC -->|"Allowed"| EVAL

    LOGIN -.-> TWO_FA
    DOC_JOB -.-> INGEST
    INDEX -.-> INGEST
    REQUEST -.-> DURABLE
    TICKET -.-> TICKET_UI
    HOME -.-> MONITOR
    AGENT -.-> RETRIEVAL_RBAC

    classDef current fill:#12352f,stroke:#2dd4bf,stroke-width:2px,color:#e6fffb;
    classDef future fill:#33270f,stroke:#f59e0b,stroke-width:2px,color:#fff7df,stroke-dasharray:6 4;
    classDef decision fill:#172554,stroke:#60a5fa,stroke-width:2px,color:#eff6ff;
    class START,LOGIN,ROLE,CONV,QUESTION,REQUEST,TASK,AGENT,MAP,POLL,ANSWER,SOURCE,CLARIFY,FOLLOWUP,CONTEXT,REFUSED,TICKET,FAILED,RETRY,DOCS,DOC_JOB,INDEX,EVAL,CURRENT current;
    class AUTH,HOME,CHAT_STATE,ADMIN_RBAC decision;
    class TWO_FA,INGEST,DURABLE,TICKET_UI,MONITOR,RETRIEVAL_RBAC,FUTURE future;
