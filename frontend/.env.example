# ─── Dùng cho local development ──────────────────────────────────────────────
# Copy file này thành .env.local và điền URL thực tế cho môi trường của bạn.
# File .env.local đã có trong .gitignore — KHÔNG commit thông tin nhạy cảm!

# URL của Backend API (FastAPI)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# URL của AI Agent Service
NEXT_PUBLIC_AGENT_BASE_URL=http://localhost:8001/api/v1/agent
