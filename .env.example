# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Database — Supabase (user/RBAC, chat history, ticket, document metadata) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Legacy (không dùng khi đã chuyển sang Supabase):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
# "cloud" = Chroma Cloud, dùng chung cho cả team + server (khuyến nghị — Render
# free/standard tier không có persistent disk nên KHÔNG dùng "local" khi deploy).
# "local" = ChromaDB PersistentClient trên đĩa, chỉ dùng dev/test offline.
VECTOR_DB_BACKEND=cloud
CHROMA_COLLECTION_NAME=hr_documents
CHROMA_CLOUD_API_KEY=your-chroma-cloud-api-key-here
CHROMA_CLOUD_TENANT=your-chroma-cloud-tenant-here
CHROMA_CLOUD_DATABASE=your-chroma-cloud-database-here
# Chỉ dùng khi VECTOR_DB_BACKEND=local:
CHROMA_PERSIST_DIR=./storage/vector_db
# Or Pinecone (phương án dự phòng nếu Chroma Cloud không đủ nhu cầu):
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- FPT.AI Marketplace (embedding/VLM/rerank/chat gateway — dùng cho cả ingestion lẫn agent RAG) ----
FPT_API_KEY=your-fpt-marketplace-key-here
EMBEDDING_MODEL=multilingual-e5-large
LLM_MODEL=GLM-5.2

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
