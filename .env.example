# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Database — Supabase (user/RBAC, chat history, ticket, document metadata) ----
# Backend uses SQLAlchemy/asyncpg, so this must be the PostgreSQL connection
# string from Supabase Dashboard -> Project Settings -> Database.
# Prefer the Session pooler URI for Docker/local development. URL-encode special
# characters in the database password.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@your-session-pooler-host:5432/postgres

# Authentication is stored in public.users/public.profiles on the same database.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Vector Store ----
# "cloud" = Chroma Cloud, dùng chung cho cả team + server (khuyến nghị — Render
# free/standard tier không có persistent disk nên KHÔNG dùng "local" khi deploy).
# "local" = ChromaDB PersistentClient trên đĩa, chỉ dùng dev/test offline.
VECTOR_DB_BACKEND=cloud
CHROMA_COLLECTION_NAME=hr_documents
CHROMA_CLOUD_API_KEY=your-chroma-cloud-api-key-here
CHROMA_CLOUD_TENANT=your-chroma-cloud-tenant-here
CHROMA_CLOUD_DATABASE=your-chroma-cloud-database-here
# Chỉ dùng khi VECTOR_DB_BACKEND=local:
CHROMA_PERSIST_DIR=./storage/vector_db
# Or Pinecone (phương án dự phòng nếu Chroma Cloud không đủ nhu cầu):
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- FPT.AI Marketplace (embedding/VLM/rerank/chat gateway — dùng cho cả ingestion lẫn agent RAG) ----
FPT_API_KEY=your-fpt-marketplace-key-here
EMBEDDING_MODEL=multilingual-e5-large
LLM_MODEL=GLM-5.2

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Internal Backend <-> Agent Service ----
AI_AGENT_SERVICE_URL=http://localhost:8001/api/v1/agent
AI_AGENT_TIMEOUT_SECONDS=60
# Use the same secret in Backend (AI_AGENT_SERVICE_TOKEN) and Agent (AGENT_SERVICE_TOKEN).
AI_AGENT_SERVICE_TOKEN=change-me
AGENT_SERVICE_TOKEN=change-me

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
